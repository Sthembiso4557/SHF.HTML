}

html{
    scroll-behavior:smooth;
}

body{
    background:#f4efe7;
    color:#171512;
    font-family:"DM Sans",sans-serif;
    overflow-x:hidden;
}

/* ================= NAVIGATION ================= */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    padding:25px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
