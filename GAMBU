/* ================= SCROLL ANIMATION ================= */

.reveal{
    opacity:0;
    transform:translateY(60px);
    transition:1s;
}

.reveal.active{
    opacity:1;
    transform:translateY(0);
}

/* ================= ANIMATIONS ================= */

@keyframes heroIn{
    from{
        opacity:0;
        transform:translateY(50px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes marquee{
    from{
        transform:translateX(0);
    }

    to{
        transform:translateX(-50%);
    }
}

@keyframes spin{
    from{
        transform:rotate(0);
    }

    to{
        transform:rotate(360deg);
    }
}

/* ================= MOBILE ================= */

@media(max-width:850px){

    nav ul{
