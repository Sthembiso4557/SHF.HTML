}

.logo{
    font-family:"Playfair Display",serif;
    font-size:30px;
    letter-spacing:5px;
}

nav ul{
    display:flex;
    list-style:none;
    gap:35px;
}

nav a{
    color:white;
    text-decoration:none;
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:2px;
}

.nav-btn{
    border:1px solid rgba(255,255,255,.6);
    padding:12px 20px;
}

/* ================= HERO ================= */

.hero{
    height:100vh;
    min-height:700px;

    background:
    linear-gradient(90deg,
    rgba(10,9,7,.78),
    rgba(10,9,7,.25)),
    url("https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=2200&q=90");

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;
    padding:0 9%;

    color:white;

    position:relative;
}

.hero-content{
    max-width:800px;
    animation:heroIn 1.5s ease;
}

.small-title{
    text-transform:uppercase;
    letter-spacing:6px;
    font-size:12px;
    margin-bottom:25px;
    color:#d8b477;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-size:clamp(70px,11vw,160px);
    line-height:.85;
    font-weight:500;
}

.hero h1 span{
    color:#d6ae6d;
}

.hero p{
    max-width:500px;
    margin-top:35px;
    font-size:17px;
    line-height:1.8;
    color:#e8e3da;
}

.hero-buttons{
    margin-top:40px;
    display:flex;
    gap:15px;
}

.button{
    padding:16px 30px;
    text-decoration:none;
    text-transform:uppercase;
    letter-spacing:2px;
    font-size:12px;
    transition:.3s;
}

.gold-button{
    background:#c49a59;
    color:#171512;
}

.gold-button:hover{
    background:#e0bd80;
    transform:translateY(-4px);
}

.outline-button{
    border:1px solid rgba(255,255,255,.7);
    color:white;
}

.outline-button:hover{
    background:white;
    color:#171512;
}

/* FLOATING CIRCLE */

.floating-circle{
    position:absolute;
    right:7%;
    bottom:10%;
    width:130px;
    height:130px;
    border:1px solid rgba(255,255,255,.5);
    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    animation:spin 15s linear infinite;
}

.floating-circle span{
    font-size:10px;
    letter-spacing:2px;
}

/* ================= INTRO ================= */

.intro{
    padding:130px 9%;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:80px;
    align-items:center;
}

.intro h2{
    font-family:"Playfair Display",serif;
    font-size:65px;
    font-weight:500;
}

.intro h2 span{
    color:#a87935;
}

.intro-text{
    font-size:17px;
    line-height:1.9;
    color:#5e594f;
}

.signature{
    margin-top:30px;
    font-family:"Playfair Display",serif;
    font-size:30px;
    font-style:italic;
}

/* ================= MOVING MARQUEE ================= */

.marquee{
    background:#171512;
    color:#e2c187;
    overflow:hidden;
    padding:18px 0;
    white-space:nowrap;
}

.marquee-track{
    display:inline-block;
    animation:marquee 20s linear infinite;
}

.marquee span{
    margin:0 35px;
    text-transform:uppercase;
    letter-spacing:5px;
    font-size:12px;
}

/* ================= MENU ================= */

.menu-section{
    padding:130px 7%;
}

.section-heading{
    text-align:center;
    margin-bottom:70px;
}

.section-heading small{
    color:#a87935;
    text-transform:uppercase;
    letter-spacing:5px;
}

.section-heading h2{
    font-family:"Playfair Display",serif;
    font-size:65px;
    font-weight:500;
    margin-top:15px;
}

.menu-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.menu-card{
    position:relative;
    overflow:hidden;
    height:520px;
    cursor:pointer;
}

.menu-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:1s;
}

.menu-card:hover img{
    transform:scale(1.1);
}

.menu-overlay{
    position:absolute;
    inset:0;

    display:flex;
    flex-direction:column;
    justify-content:flex-end;

    padding:35px;

    color:white;

    background:
    linear-gradient(
    transparent 30%,
    rgba(0,0,0,.85)
    );
}

.menu-overlay h3{
    font-family:"Playfair Display",serif;
    font-size:32px;
}

.menu-overlay p{
    margin-top:10px;
    color:#ddd;
}

.price{
    margin-top:15px;
    color:#d8b477;
    font-size:18px;
}

/* ================= EXPERIENCE ================= */

.experience{
